{
  "name": "document-ingestion-pipeline",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "main": "index.js",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js --external:@aws-sdk/* --external:@lancedb/lancedb",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\""
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "apache-arrow": ">=15.0.0 <=18.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@eslint/js": "^10.0.1",
    "@langchain/aws": "^1.3.5",
    "@langchain/core": "^1.1.42",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "25.x",
    "esbuild": "^0.25.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
