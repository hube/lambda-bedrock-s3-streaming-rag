{
  "name": "lambda-bedrock-s3-streaming-rag",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "packages/cdk",
    "packages/data-pipeline",
    "packages/rag-query-function"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "typecheck": "yarn workspaces foreach --all --parallel run typecheck",
    "lint": "yarn workspaces foreach --all --parallel run lint",
    "lint:fix": "yarn workspaces foreach --all --parallel run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "25.x",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
